# Ozera Frontend Environment Configuration

# API URL for the Ozera backend server
VITE_API_URL=http://localhost:8000

# SAE Inference API URL (Phase 3)
# This is the Modal-deployed SAE inference service
# Default points to the production Modal deployment
VITE_SAE_API_URL=https://adrianmcli--ozera-sae-inference.modal.run

# Stripe Configuration (Phase 2)
# The publishable key is fetched from the backend via /payments/config
# but you can optionally set it here for faster initialization
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
