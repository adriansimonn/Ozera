# Phase 1: Core Model Development
# Minimal configuration for model development

# Development
ENVIRONMENT=development
DEBUG=true

# Storage (local only for now)
MODELS_DIR=./backend/models
CHECKPOINTS_DIR=./backend/models/checkpoints
DATASETS_DIR=./data/datasets

# Phase 2+ Configuration (uncomment when needed)
# API, database, and deployment settings

# # API Settings
# API_HOST=0.0.0.0
# API_PORT=8000
# API_WORKERS=4

# # Database
# DATABASE_URL=postgresql+asyncpg://ozera:password@localhost:5432/ozera

# # Redis Cache
# REDIS_URL=redis://localhost:6379/0

# # Authentication
